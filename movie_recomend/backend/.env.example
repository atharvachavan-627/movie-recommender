# ==============================================================================
# MovieMind — Environment Configuration Reference
# ==============================================================================

# --- JWT Secret for Authentication ---
# Used for cryptographically signing user and administrator session tokens
MOVIEMIND_JWT_SECRET=moviemind_jwt_secret_key_dwm_project_2026

# --- Predefined System Administrator Account ---
# Predefined development administrator credentials for academic evaluation
ADMIN_USERNAME=moviemind_admin
ADMIN_PASSWORD=MovieMindDemo2026!

# (Optional) Pre-computed Bcrypt hash for ADMIN_PASSWORD.
# If left blank, the backend automatically hashes ADMIN_PASSWORD at startup using bcrypt.
ADMIN_PASSWORD_HASH=

# Administrator Session Expiry in minutes (default: 120 minutes / 2 hours)
ADMIN_SESSION_EXPIRE_MINUTES=120

# Regular User Token Expiry in minutes (default: 60 minutes)
MOVIEMIND_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- SQLite Database URL ---
MOVIEMIND_DATABASE_URL=sqlite:///moviemind.db

# --- Permitted CORS Frontend Origins (comma-separated) ---
MOVIEMIND_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
